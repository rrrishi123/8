# operator content, not witness machinery (#321) — the higgsfield movie pipeline
# lives at ~/.8/higgsfield (#356); on this host a compat SYMLINK sits here so
# stale path references keep resolving. No trailing slash: the dir-only pattern
# would miss the symlink. See higgsfield-relocated.md
/higgsfield

# built binary — build from source (go build ./collector); never track a host binary
/collector/.bin-collector

# private design-system reference — never public
/web/design-reference/_ds/

# tsc -b incremental state — per-checkout, never tracked (#1146c/#1147)
web/*.tsbuildinfo

